generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  GUEST
  STUDENT
  INSTRUCTOR
  ADMIN
  SUPER_ADMIN
}

enum TestModule {
  LISTENING
  READING
  WRITING
  SPEAKING
}

enum TestVariant {
  ACADEMIC
  GENERAL
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum MediaType {
  IMAGE
  AUDIO
}

enum TestKind {
  PRACTICE
  MOCK
  FINAL
}

enum QuestionType {
  MULTIPLE_CHOICE
  FILL_IN_BLANK
  TRUE_FALSE_NOT_GIVEN
  YES_NO_NOT_GIVEN
  MATCHING_HEADINGS
  MATCHING_INFORMATION
  SENTENCE_COMPLETION
  SUMMARY_COMPLETION
  SHORT_ANSWER
}

enum WritingTaskType {
  TASK_1_ACADEMIC
  TASK_1_GENERAL
  TASK_2
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  ERROR
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SpeakingPart {
  PART_1
  PART_2_PREP
  PART_2
  PART_3
}

enum SpeakingTurnRole {
  EXAMINER
  CANDIDATE
}

model User {
  id                   String           @id @default(cuid())
  supabaseId           String           @unique
  email                String           @unique
  name                 String?
  role                 UserRole         @default(STUDENT)
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  lastLoginAt          DateTime?

  profile              UserProfile?
  instructorProfile    InstructorProfile?
  testAttempts         TestAttempt[]
  writingAttempts      WritingAttempt[]
  speakingAttempts     SpeakingAttempt[]
  subscription         Subscription?
  studentBookings      Booking[]        @relation("StudentBookings")
  instructorBookings   Booking[]        @relation("InstructorBookings")
  instructorSlots      InstructorSlot[]
}

model UserProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetBand           Float?
  currentBand          Float?
  examDate             DateTime?
  studyProfession      String?
  examReason           String?
  weakSkills           String[] @default([])
  examTimeline         String?
  onboardingCompleted  Boolean  @default(false)
  timezone             String   @default("UTC")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model InstructorProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline             String?
  bio                  String?
  history              String?
  achievements         String[] @default([])
  specialties          String[] @default([])
  experienceYears      Int?
  avatarUrl            String?
  likesCount           Int      @default(0)
  commentsCount        Int      @default(0)
  viewsCount           Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model InstructorApplication {
  id                   String   @id @default(cuid())
  name                 String
  email                String
  phone                String?
  teachingExperience   String
  ieltsExpertise       String
  motivation           String
  education            String?
  specialties          String[] @default([])
  status               String   @default("PENDING")
  adminNotes           String?
  reviewedAt           DateTime?
  reviewedById         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model Test {
  id                   String        @id @default(cuid())
  title                String
  description          String?
  module               TestModule
  variant              TestVariant   @default(ACADEMIC)
  difficulty           Difficulty    @default(MEDIUM)
  kind                 TestKind      @default(PRACTICE)
  durationMins         Int           @default(60)
  totalQuestions       Int           @default(40)
  totalParts           Int?
  isPractice           Boolean       @default(true)
  isActive             Boolean       @default(true)
  audioUrl             String?
  sourceConfig         Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  sections             TestSection[]
  attempts             TestAttempt[]

  @@index([module, kind, isActive])
}

model TestSection {
  id                   String      @id @default(cuid())
  testId               String
  test                 Test        @relation(fields: [testId], references: [id], onDelete: Cascade)
  title                String
  order                Int         @default(1)
  passage              String?
  audioUrl             String?
  sourcePassageId      String?
  sourcePassage        Passage?    @relation("SectionPassage", fields: [sourcePassageId], references: [id])

  questions            Question[]

  @@index([testId, order])
  @@index([sourcePassageId])
}

model Question {
  id                   String           @id @default(cuid())
  sectionId            String
  section              TestSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  testId               String
  type                 QuestionType
  order                Int
  questionText         String
  questionContext      String?
  correctAnswer        String
  acceptedAnswers      String[]         @default([])
  explanation          String?
  points               Int              @default(1)
  sourceBankItemId     String?
  sourceBankItem       QuestionBankItem? @relation("QuestionSourceBank", fields: [sourceBankItemId], references: [id])
  sourcePassageId      String?
  sourcePassage        Passage?         @relation("QuestionSourcePassage", fields: [sourcePassageId], references: [id])
  sourceMediaType      MediaType?
  imageUrl             String?
  audioUrl             String?

  options              QuestionOption[]
  answers              Answer[]

  @@index([sectionId, order])
  @@index([sourceBankItemId])
  @@index([sourcePassageId])
}

model QuestionOption {
  id                   String    @id @default(cuid())
  questionId           String
  question             Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label                String
  text                 String
  isCorrect            Boolean   @default(false)
}

model TestAttempt {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId               String
  test                 Test           @relation(fields: [testId], references: [id])
  status               AttemptStatus  @default(IN_PROGRESS)
  mode                 String         @default("simulation")
  startedAt            DateTime       @default(now())
  completedAt          DateTime?
  bandScore            Float?
  rawScore             Int?
  correctCount         Int?
  totalCount           Int?
  timeTakenSecs        Int?

  answers              Answer[]
}

model Answer {
  id                   String      @id @default(cuid())
  attemptId            String
  attempt              TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId           String
  question             Question    @relation(fields: [questionId], references: [id])
  givenAnswer          String?
  isCorrect            Boolean?
  pointsAwarded        Int         @default(0)
}

model WritingPrompt {
  id                   String           @id @default(cuid())
  title                String
  taskType             WritingTaskType
  promptText           String
  imageUrl             String?
  variant              TestVariant      @default(ACADEMIC)
  difficulty           Difficulty       @default(MEDIUM)
  topic                String?
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())

  attempts             WritingAttempt[]
}

model WritingAttempt {
  id                   String           @id @default(cuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptId             String
  prompt               WritingPrompt    @relation(fields: [promptId], references: [id])
  response             String           @default("")
  wordCount            Int              @default(0)
  status               AttemptStatus    @default(IN_PROGRESS)
  startedAt            DateTime         @default(now())
  submittedAt          DateTime?

  evaluation           WritingEvaluation?
}

model WritingEvaluation {
  id                    String          @id @default(cuid())
  attemptId             String          @unique
  attempt               WritingAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  taskAchievement       Float?
  coherenceCohesion     Float?
  lexicalResource       Float?
  grammaticalRange      Float?
  overallBand           Float?
  strengths             String[]        @default([])
  weaknesses            String[]        @default([])
  corrections           Json            @default("[]")
  vocabularySuggestions Json            @default("[]")
  sampleRewrite         String?
  examinerSummary       String?
  evaluatedAt           DateTime        @default(now())
}

model SpeakingAttempt {
  id                   String          @id @default(cuid())
  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               AttemptStatus   @default(IN_PROGRESS)
  mode                 String          @default("simulation")
  startedAt            DateTime        @default(now())
  submittedAt          DateTime?
  completedAt          DateTime?
  currentPart          SpeakingPart    @default(PART_1)
  currentQuestionIndex Int             @default(0)
  totalQuestionsAsked  Int             @default(0)
  latestExaminerPrompt String?
  transcriptFull       String          @default("")
  metadata             Json?
  errorMessage         String?

  turns                SpeakingTurn[]
  evaluation           SpeakingEvaluation?

  @@index([userId, status, startedAt])
}

model SpeakingTurn {
  id                   String           @id @default(cuid())
  attemptId            String
  attempt              SpeakingAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  part                 SpeakingPart
  role                 SpeakingTurnRole @default(CANDIDATE)
  sequence             Int
  examinerPrompt       String
  userTranscript       String           @default("")
  transcriptSource     String?
  fillerWordCount      Int              @default(0)
  pauseCount           Int              @default(0)
  pauseDurationMs      Int              @default(0)
  speechRateWpm        Float?
  durationMs           Int?
  startedAt            DateTime         @default(now())
  endedAt              DateTime?
  silencePromptShown   Boolean          @default(false)
  metadata             Json?

  recording            SpeakingRecording?

  @@unique([attemptId, sequence])
  @@index([attemptId, part, sequence])
}

model SpeakingRecording {
  id                   String       @id @default(cuid())
  turnId               String       @unique
  turn                 SpeakingTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)
  storagePath          String?
  publicUrl            String?
  mimeType             String?
  durationMs           Int?
  sizeBytes            Int?
  createdAt            DateTime     @default(now())
}

model SpeakingEvaluation {
  id                      String          @id @default(cuid())
  attemptId               String          @unique
  attempt                 SpeakingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  fluencyCoherence        Float?
  lexicalResource         Float?
  grammaticalRangeAccuracy Float?
  pronunciation           Float?
  overallBand             Float?
  criterionFeedback       Json            @default("{}")
  actionableTips          Json            @default("[]")
  grammarCorrections      Json            @default("[]")
  vocabularyUpgrades      Json            @default("[]")
  strengths               String[]        @default([])
  weaknesses              String[]        @default([])
  pronunciationSummary    Json            @default("{}")
  examinerSummary         String?
  evaluatedAt             DateTime        @default(now())
}

model InstructorSlot {
  id                   String    @id @default(cuid())
  instructorId         String
  instructor           User      @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  startTime            DateTime
  endTime              DateTime
  isBooked             Boolean   @default(false)
  timezone             String    @default("UTC")

  booking              Booking?
}

model Booking {
  id                   String         @id @default(cuid())
  studentId            String
  student              User           @relation("StudentBookings", fields: [studentId], references: [id])
  instructorId         String
  instructor           User           @relation("InstructorBookings", fields: [instructorId], references: [id])
  slotId               String         @unique
  slot                 InstructorSlot @relation(fields: [slotId], references: [id])
  status               BookingStatus  @default(PENDING)
  meetLink             String?
  notes                String?
  instructorBandScore  Float?
  createdAt            DateTime       @default(now())
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String    @default("free")
  status               String    @default("active")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
}

model Passage {
  id                   String           @id @default(cuid())
  title                String
  content              String?
  module               TestModule
  sectionPart          Int              @default(1)
  wordCount            Int?
  difficulty           Difficulty       @default(MEDIUM)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  media                PassageMedia[]
  bankQuestions        QuestionBankItem[]
  mappedSections       TestSection[]    @relation("SectionPassage")
  mappedQuestions      Question[]       @relation("QuestionSourcePassage")

  @@index([module, sectionPart])
  @@index([difficulty])
}

model PassageMedia {
  id                   String      @id @default(cuid())
  passageId            String
  passage              Passage     @relation(fields: [passageId], references: [id], onDelete: Cascade)
  type                 MediaType
  url                  String
  storagePath          String?
  label                String?
  order                Int         @default(1)
  createdAt            DateTime    @default(now())

  @@index([passageId, type, order])
}

model QuestionBankItem {
  id                   String             @id @default(cuid())
  questionText         String
  type                 QuestionType
  module               TestModule
  sectionPart          Int?
  difficulty           Difficulty         @default(MEDIUM)
  points               Int                @default(1)
  correctAnswer        String?
  acceptedAnswers      String[]           @default([])
  explanation          String?
  passageId            String?
  passage              Passage?           @relation(fields: [passageId], references: [id], onDelete: SetNull)
  imageUrl             String?
  audioUrl             String?
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  options              QuestionBankOption[]
  mappedQuestions      Question[]         @relation("QuestionSourceBank")

  @@index([module, sectionPart])
  @@index([passageId])
  @@index([type])
  @@index([isActive])
}

model QuestionBankOption {
  id                   String           @id @default(cuid())
  bankItemId           String
  bankItem             QuestionBankItem @relation(fields: [bankItemId], references: [id], onDelete: Cascade)
  label                String
  text                 String
  isCorrect            Boolean          @default(false)

  @@index([bankItemId, label])
}
